GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=finance-ai-498921
GOOGLE_CLOUD_LOCATION=global

# --- Auth / BFF integration ---
# Shared secret that Finance_UI's server-side proxy sends in the
# X-Internal-Secret header on every request. Both services must use the
# same value. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_INTERNAL_SECRET=change-me-to-a-real-secret

# Comma-separated list of allowed CORS origins. Only matters if browsers
# could reach this service directly (they shouldn't in production).
ALLOWED_ORIGIN=http://localhost:3000
